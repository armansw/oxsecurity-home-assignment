{
  "name": "code-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Memory-bounded Trivy scanning service: async scan API (REST + GraphQL) with stream-parsed reports.",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:constrained": "node --max-old-space-size=150 dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fixture:generate": "node dist/scripts/generate-fixture.js",
    "oom:check": "npm run build && node --max-old-space-size=150 dist/scripts/oom-check.js",
    "check": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "graphql": "^17.1.0",
    "mercurius": "^16.12.1",
    "pino": "^10.4.0",
    "stream-chain": "^4.4.2",
    "stream-json": "^3.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
