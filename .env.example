# All variables are optional; values shown are the defaults. Validated at boot (src/config/env.ts).
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# all = API + worker in one process | api | worker
ROLE=all

DATABASE_PATH=./data/code-guardian.db
# Must be disk-backed (never tmpfs) — see docs/MEMORY.md
WORK_DIR=/tmp/code-guardian

# trivy | fixture (synthetic report of FIXTURE_SIZE_MB, for the OOM proof)
SCANNER=trivy
TRIVY_BIN=trivy
# Client/server mode when set (recommended in containers)
# TRIVY_SERVER_URL=http://trivy:4954
# TRIVY_TOKEN=change-me
# TRIVY_CACHE_DIR=/tmp/code-guardian/.trivy-cache
TRIVY_GOMEMLIMIT=48MiB
TRIVY_GOGC=50
GIT_BIN=git
CLONE_TIMEOUT_MS=300000
SCAN_TIMEOUT_MS=1200000
ALLOWED_GIT_HOSTS=github.com

MAX_ATTEMPTS=3
MAX_QUEUED=100
# Opt-in: return the active scan for the same repo instead of creating a new one
DEDUPE_ACTIVE_SCANS=false
TRUST_PROXY=false
WORKER_CONCURRENCY=1
WORKER_POLL_MS=500
HEARTBEAT_MS=5000
STALE_AFTER_MS=60000
RETRY_BASE_MS=5000
SHUTDOWN_GRACE_MS=10000
MIN_FREE_DISK_MB=1024
BATCH_SIZE=500
RESPONSE_PAGE_SIZE=500
MAX_JSON_VALUE_BYTES=1048576
SCAN_TTL_HOURS=168
RATE_LIMIT_PER_MIN=30

FIXTURE_SIZE_MB=600
FIXTURE_CRITICAL_RATIO=0.05
