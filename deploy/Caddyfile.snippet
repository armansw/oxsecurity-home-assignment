# Code Guardian (OX Security home assignment) — systemd: code-guardian.service, code-guardian-trivy.service
oxhometask.armstep.com {
	encode zstd gzip
	handle /api/* {
		# flush_interval -1: stream the unpaginated scan JSON through instead of buffering it.
		reverse_proxy 127.0.0.1:8795 {
			flush_interval -1
		}
	}
	handle /graphql* {
		reverse_proxy 127.0.0.1:8795
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8795
	}
	handle {
		root * /var/www/oxhometask
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
