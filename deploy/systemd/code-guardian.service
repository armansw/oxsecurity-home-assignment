[Unit]
Description=Code Guardian - scan API + worker (oxhometask.armstep.com)
After=network-online.target code-guardian-trivy.service
Wants=network-online.target code-guardian-trivy.service

[Service]
WorkingDirectory=/opt/code-guardian
EnvironmentFile=/etc/code-guardian/env
Environment=NODE_ENV=production ROLE=all HOST=127.0.0.1 PORT=8795 LOG_LEVEL=info TRUST_PROXY=loopback
Environment=DATABASE_PATH=/var/lib/code-guardian/code-guardian.db WORK_DIR=/var/lib/code-guardian/work
Environment=TRIVY_SERVER_URL=http://127.0.0.1:4954 TRIVY_BIN=/usr/local/bin/trivy GIT_BIN=/usr/bin/git
Environment=HOME=/var/lib/code-guardian MIN_FREE_DISK_MB=2048 MAX_QUEUED=10 RATE_LIMIT_PER_MIN=10
# The brief's self-test command, inside the same 200 MB / no-swap limit as docker-compose (mem_limit: 200m).
ExecStart=/usr/bin/node --max-old-space-size=150 dist/index.js
DynamicUser=yes
StateDirectory=code-guardian
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
MemoryMax=200M
MemorySwapMax=0
CPUQuota=60%
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
